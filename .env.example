# Copy to .env and fill in. .env is gitignored; this template is not.
#
# ---------------------------------------------------------------------------
# Supabase — accounts, wishlist, order records
# ---------------------------------------------------------------------------
# Both VITE_* values are safe in the browser bundle: the publishable key only
# ever acts through Row Level Security, which is enabled on every table.
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only. Bypasses RLS — never prefix it with VITE_, never send it to the
# browser. Used by the order server function to read an order back before
# pushing it to the sheet, so logistics receives database-verified data
# rather than whatever the client posted.
# Dashboard → Project Settings → API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Google Sheet — the logistics queue
# ---------------------------------------------------------------------------
# Deploy scripts/sheet-webhook.gs as an Apps Script Web App and paste its
# /exec URL here. See scripts/SHEET-SETUP.md for the walkthrough.
SHEETS_WEBHOOK_URL=""

# Must match SHARED_SECRET inside the Apps Script. Any random string; it stops
# strangers writing rows into your sheet.
SHEETS_WEBHOOK_SECRET=""
